head
    title Hentede brugere

body
    h1 Oversigt over brugere
    p Antal brugere: #{users.length}

    table(border='1')
        tr 
            th Navn 
            th Alder 
            th By 
            th Email 
            th Telefon

        each user in users 
            tr 
                td #{user.name.first} #{user.name.last}
                td #{user.dob.age}
                td #{user.location.city}
                td #{user.email}
                td #{user.phone}
                td 
                    img(src=user.picture.thumbnail)
